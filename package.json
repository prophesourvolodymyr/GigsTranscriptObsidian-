{
  "name": "link-video-transcriber",
  "version": "0.1.0",
  "description": "Automatically transcribe videos from any platform (YouTube, Instagram, X, TikTok, etc.) into searchable Obsidian notes with AI summaries",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "video",
    "transcription",
    "whisper",
    "ai",
    "youtube",
    "instagram",
    "twitter"
  ],
  "author": "Link Video Transcriber Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.19.10",
    "eslint": "^8.56.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@google/generative-ai": "^0.1.3",
    "axios": "^1.6.2",
    "handlebars": "^4.7.8",
    "moment": "^2.29.4",
    "openai": "^4.20.1"
  }
}
